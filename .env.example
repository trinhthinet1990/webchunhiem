# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH SUPABASE (HOMEROOM 360)
# Hãy đổi tên file này thành .env và điền thông tin Supabase của bạn
# ==============================================================================

# CÁCH 1: Sử dụng chuỗi kết nối PostgreSQL URI (Khuyên dùng nhất)
# Lấy tại Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Chú ý: Nhớ thay [YOUR-PASSWORD] bằng mật khẩu cơ sở dữ liệu bạn đã đặt khi tạo project.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# CÁCH 2: Điền chi tiết từng thông số (Nếu không dùng DATABASE_URL ở trên):
# SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.your-project-ref
# SUPABASE_DB_PASSWORD=your-db-password

# THÔNG TIN API SUPABASE (Tùy chọn nếu cần gọi Supabase SDK / Storage):
# Lấy tại Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
